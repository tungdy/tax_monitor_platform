# Local Compose example only. Replace these values; never reuse them as production secrets.
POSTGRES_DB=tax_risk
POSTGRES_USER=tax_risk_owner
POSTGRES_PASSWORD=replace-for-local-development-only
POSTGRES_APP_USER=tax_risk_app
POSTGRES_APP_PASSWORD=replace-for-local-application-only
POSTGRES_PORT=5432
REDIS_PORT=6379

# Compose-internal service names are postgres and redis (not localhost).
MIGRATION_DATABASE_URL=postgresql+psycopg://tax_risk_owner:replace-for-local-development-only@postgres:5432/tax_risk
DATABASE_URL=postgresql+psycopg://tax_risk_app:replace-for-local-application-only@postgres:5432/tax_risk
REDIS_URL=redis://redis:6379/0

# Production external reads use a bounded thread pool plus Redis cache/lock leases.
# Per-source concurrency uses the pydantic-settings nested environment delimiter.
EXTERNAL_FETCH_ENABLED=true
EXTERNAL_FETCH_CACHE_ENABLED=true
EXTERNAL_FETCH_MAX_WORKERS=12
EXTERNAL_FETCH_SOURCE_CONCURRENCY__DGC_SAP_PROFIT=4
EXTERNAL_FETCH_SOURCE_CONCURRENCY__DGC_SAP_TRIAL_BALANCE=4
EXTERNAL_FETCH_SOURCE_CONCURRENCY__DGC_SAP_ACCOUNT_BALANCE=4
EXTERNAL_FETCH_SOURCE_CONCURRENCY__DGC_HESI_REIMBURSEMENT=4
EXTERNAL_FETCH_SOURCE_CONCURRENCY__DGC_HESI_INVOICE=4
EXTERNAL_FETCH_SOURCE_CONCURRENCY__DGC_HESI_APPLICATION=4
EXTERNAL_FETCH_SOURCE_CONCURRENCY__DGC_SAP_DIVIDEND_DETAIL=4
EXTERNAL_FETCH_SOURCE_CONCURRENCY__DGC_INVOICE_DETAIL=4
EXTERNAL_FETCH_CACHE_PREFIX=tax-risk:external-fetch
EXTERNAL_FETCH_CACHE_TTL_SECONDS=900
EXTERNAL_FETCH_EMPTY_CACHE_TTL_SECONDS=60
EXTERNAL_FETCH_LOCK_TTL_SECONDS=300
EXTERNAL_FETCH_LOCK_WAIT_SECONDS=305
EXTERNAL_FETCH_LOCK_POLL_SECONDS=0.1
EXTERNAL_FETCH_RETRY_MAX_ATTEMPTS=3
EXTERNAL_FETCH_RETRY_BASE_DELAY_SECONDS=0.25
EXTERNAL_FETCH_RETRY_MAX_DELAY_SECONDS=5
EXTERNAL_FETCH_RETRY_JITTER_RATIO=0.2

API_PORT=8000
WEB_PORT=8080
QUARTERLY_WORKER_CONCURRENCY=4
MONTHLY_WORKER_CONCURRENCY=4
EXPORT_WORKER_CONCURRENCY=2
VITE_API_BASE_URL=

# Browser login. Generate password hashes with backend/scripts/hash_login_password.py,
# then add accounts to the JSON map. Never put plaintext passwords in this file.
AUTH_SESSION_SECRET=
AUTH_SESSION_COOKIE_NAME=tax_risk_session
AUTH_SESSION_TTL_SECONDS=28800
AUTH_OAUTH_STATE_TTL_SECONDS=600
AUTH_LOGIN_MAX_FAILURES=5
AUTH_LOGIN_WINDOW_SECONDS=300
AUTH_LOCAL_ACCOUNTS={}

# Feishu OAuth login. The redirect URI must exactly match the URI registered in
# the Feishu developer console. Principal keys are Feishu user open_id values.
AUTH_FEISHU_ENABLED=false
AUTH_FEISHU_CLIENT_ID=
AUTH_FEISHU_CLIENT_SECRET=
AUTH_FEISHU_REDIRECT_URI=http://127.0.0.1:8080/api/v1/auth/feishu/callback
AUTH_FEISHU_TENANT_KEY=
AUTH_FEISHU_PRINCIPALS={}
AUTH_FEISHU_TIMEOUT_SECONDS=15

# Local-only independent HMAC secrets. Production values must come from a secret store.
EXPORT_DOWNLOAD_SECRET=local-only-export-download-signing-secret-change-me
WORKER_SCOPE_SECRET=local-only-worker-scope-signing-secret-change-me

# SAP profit statement ingestion through DGC is off by default. When enabling it,
# inject AppKey/AppSecret from a deployment secret store. IAM credentials remain an
# explicit compatibility option; configure exactly one authentication method.
DGC_SAP_PROFIT_ENABLED=false
DGC_IAM_URL=https://iam.cn-east-3.myhuaweicloud.com/v3/auth/tokens
DGC_SAP_PROFIT_API_URL=https://116.63.221.181/post/sapincome
DGC_APP_KEY=
DGC_APP_SECRET=
DGC_IAM_USERNAME=
DGC_IAM_PASSWORD=
DGC_IAM_DOMAIN=hljtzb
DGC_IAM_PROJECT=cn-east-3
DGC_TIMEOUT_SECONDS=30
DGC_PAGE_SIZE=15000
DGC_MAX_PAGES=1000
DGC_MAX_RECORDS=100000
DGC_MAX_PAGE_BYTES=10485760
DGC_MAX_TOTAL_BYTES=67108864
DGC_TOKEN_TTL_SECONDS=82800
# The leaf certificate is pinned because the DGC endpoint uses a self-signed
# certificate on an IP URL. Rotate both values only after an approved fingerprint check.
DGC_TLS_SERVER_NAME=dgc.huaweicloud.com
DGC_TLS_PINNED_CERTIFICATE_SHA256=AF3850E5ACC206D12082BDD32E94AD4675F3AD7AB0AE23A247053DE9ED2883BF
DGC_SAP_PROFIT_FIELD_MAP={"client":"mandt","company_code":"bukrs","company_name":"companyname","fiscal_year":"gjahr","fiscal_period":"monat","ledger":"rldnr","line_number":"hs","line_item":"ztext","current_month_amount":"nmhsl","year_to_date_amount":"nyhsl"}
DGC_SAP_PROFIT_METRIC_MAP={"cumulative_profit":["利润总额","四、利润总额","四、利润总额（损失以“－”号填列）","四、利润总额(损失以\"-\"号填列)"],"fair_value_change":["公允价值变动收益","公允价值变动损益","公允价值变动收益（损失以“－”号填列）","公允价值变动收益(损失以\"-\"号填列)"],"cumulative_revenue":["一、营业总收入","营业收入"]}
DGC_SAP_PROFIT_LEDGER=0L

# SAP G/L account activity (trial balance) configuration. The API contract uses
# limitValue=1000 and offsetValue=0; the connector will own pagination once enabled.
DGC_SAP_TRIAL_BALANCE_ENABLED=false
DGC_SAP_TRIAL_BALANCE_API_URL=https://116.63.221.181/fin/trial_balance
DGC_SAP_TRIAL_BALANCE_APP_KEY=
DGC_SAP_TRIAL_BALANCE_APP_SECRET=
DGC_SAP_TRIAL_BALANCE_PAGE_SIZE=1000

# SAP G/L account balance configuration. company_code is optional; fiscal_year,
# fiscal_period, limitValue, and offsetValue are required Body fields. The connector
# will own limitValue/offsetValue; fiscal_period uses the source three-digit format.
DGC_SAP_ACCOUNT_BALANCE_ENABLED=false
DGC_SAP_ACCOUNT_BALANCE_API_URL=https://116.63.221.181/post/sapaccountbalance
DGC_SAP_ACCOUNT_BALANCE_APP_KEY=
DGC_SAP_ACCOUNT_BALANCE_APP_SECRET=
DGC_SAP_ACCOUNT_BALANCE_PAGE_SIZE=15000

# Hesi reimbursement-detail configuration. company_code and submit_date are
# optional nonblank Body fields; limitValue and offsetValue are connector-owned.
DGC_HESI_REIMBURSEMENT_ENABLED=false
DGC_HESI_REIMBURSEMENT_API_URL=https://116.63.221.181/post/hesimingxi
DGC_HESI_REIMBURSEMENT_APP_KEY=
DGC_HESI_REIMBURSEMENT_APP_SECRET=
DGC_HESI_REIMBURSEMENT_PAGE_SIZE=25
DGC_HESI_REIMBURSEMENT_FIELD_MAP={"company_code":"company_code","approval_completed_at":"flow_end_date","expense_claim_code":"expense_code","expense_type_code":"fee_type_code","expense_type_amount":"fee_type_amount"}

# DGC data source "合思报销单发票查询". company_code is an optional nonblank
# Body field; limitValue and offsetValue are required and owned by the connector.
# Keep disabled until credentials and the response-field contract are approved.
DGC_HESI_INVOICE_ENABLED=false
DGC_HESI_INVOICE_API_URL=https://116.63.221.181/post/hesiinvoice
DGC_HESI_INVOICE_APP_KEY=
DGC_HESI_INVOICE_APP_SECRET=
DGC_HESI_INVOICE_PAGE_SIZE=25
DGC_HESI_INVOICE_FIELD_MAP={"company_code":"company_code","expense_claim_code":"code","invoice_id":"invoice_id","expense_type_id":"feetypeid","expense_line_amount":"amount_standard_dec","invoice_approved_amount":"approve_amount_dec"}

# DGC data source "合思业务招待申请单". The connector sends company_code,
# limitValue, and offsetValue as signed POST query parameters with an empty body.
DGC_HESI_APPLICATION_ENABLED=false
DGC_HESI_APPLICATION_API_URL=https://116.63.221.181/post/apply
DGC_HESI_APPLICATION_APP_KEY=
DGC_HESI_APPLICATION_APP_SECRET=
DGC_HESI_APPLICATION_PAGE_SIZE=5000

# DGC data source "汇算清缴相关科目明细". company, fiscal_period, and
# fiscal_year are optional nonblank Body fields; limitValue and offsetValue are
# required and owned by the connector. Keep disabled until the deployment has
# approved credentials, the pinned certificate, and acceptance-test evidence.
DGC_SAP_DIVIDEND_DETAIL_ENABLED=false
DGC_SAP_DIVIDEND_DETAIL_API_URL=https://116.63.221.181/post/settlement_adjustment
DGC_SAP_DIVIDEND_DETAIL_APP_KEY=
DGC_SAP_DIVIDEND_DETAIL_APP_SECRET=
DGC_SAP_DIVIDEND_DETAIL_PAGE_SIZE=15000

# DGC data source "发票明细". accounting_date and comp are optional nonblank
# Body fields; limitValue and offsetValue are required and owned by the connector.
# Keep disabled until credentials and the response-field contract are approved.
DGC_INVOICE_DETAIL_ENABLED=false
DGC_INVOICE_DETAIL_API_URL=https://116.63.221.181/post/writeoff
DGC_INVOICE_DETAIL_APP_KEY=
DGC_INVOICE_DETAIL_APP_SECRET=
DGC_INVOICE_DETAIL_PAGE_SIZE=15000

# Lark Base refund status writeback. Resource identifiers are non-secret; inject
# app credentials from a secret store and enable only after the app has Base read/write access.
LARK_REFUND_WRITEBACK_ENABLED=false
LARK_REFUND_BASE_URL=https://hailiang.feishu.cn/base/A1Kwb4tkZaZdE2s3C2dcG49Fn2d
LARK_REFUND_API_BASE_URL=https://open.feishu.cn
LARK_REFUND_BASE_TOKEN=A1Kwb4tkZaZdE2s3C2dcG49Fn2d
LARK_REFUND_TABLE_ID=tbl4PCNdcl4BYzgZ
LARK_REFUND_COMPANY_CODE_FIELD_ID=fld5uBjB9R
LARK_REFUND_STATUS_FIELD_ID=fld4HLnqDk
LARK_REFUND_APP_ID=
LARK_REFUND_APP_SECRET=
LARK_REFUND_TIMEOUT_SECONDS=30
LARK_REFUND_PAGE_SIZE=100
LARK_REFUND_MAX_RETRIES=3
LARK_REFUND_WORKER_CONCURRENCY=2

# Local acceptance identity. Disable it when exercising the browser login flow.
# Never copy these fixed values into a deployed environment.
ENVIRONMENT=development
DEVELOPMENT_PRINCIPAL_ENABLED=true
DEVELOPMENT_PRINCIPAL_SECRET=local-only-tax-risk-development-secret-do-not-use-in-production
DEVELOPMENT_PRINCIPAL='{"allowed_company_ids":[],"organization_path":"/group","roles":["group-tax"],"subject":"local-group-tax"}'
DEVELOPMENT_PRINCIPAL_SIGNATURE=2909c75e972a78e525001c284bbcf21d4cb65b3e833f8ede076f0ca533c90c65
